rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.get('participantUids', []);
    }

    function isTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('memberUids', []);
    }

    function isTeamAdmin(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.captain == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('adminUids', [])
        );
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(userId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    match /userProfiles/{userId} {
      allow read, write, delete: if isOwner(userId);
    }

    match /trainingSessions/{sessionId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /aiReports/{reportId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid is string;
      allow update, delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid && request.resource.data.toUid is string;
      allow update, delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /friends/{friendId} {
      allow read, update, delete: if isOwner(resource.data.userId) || isParticipant(resource.data);
      allow create: if isOwner(request.resource.data.userId) || isParticipant(request.resource.data);
    }

    match /teams/{teamId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.get('memberUids', []) || request.auth.uid in resource.data.get('pendingInvites', []));
      allow create: if signedIn() && request.resource.data.captain == request.auth.uid;
      allow update, delete: if isTeamAdmin(teamId) || request.auth.uid in resource.data.get('pendingInvites', []);
    }

    match /teamMembers/{memberId} {
      allow read: if isTeamMember(resource.data.teamId);
      allow create, update, delete: if isTeamAdmin(request.resource.data.teamId);
    }

    match /teamInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.toUid == request.auth.uid || isTeamAdmin(resource.data.teamId));
      allow create: if isTeamAdmin(request.resource.data.teamId);
      allow update, delete: if signedIn() && (resource.data.toUid == request.auth.uid || isTeamAdmin(resource.data.teamId));
    }

    match /matches/{matchId} {
      allow read: if isParticipant(resource.data) || isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && request.auth.uid in request.resource.data.get('participantUids', []);
      allow update: if isParticipant(resource.data) || isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    match /matchInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /videos/{videoId} {
      allow read: if isOwner(resource.data.userId) || isParticipant(resource.data);
      allow create: if isOwner(request.resource.data.userId) || isParticipant(request.resource.data);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if signedIn() && request.resource.data.userId is string;
    }

    match /highlights/{highlightId} {
      allow read: if isOwner(resource.data.userId) || isParticipant(resource.data);
      allow create: if isOwner(request.resource.data.userId) || isParticipant(request.resource.data);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /trainings/{id} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /analyses/{id} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /reports/{id} {
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
    }

    match /leaderboards/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
