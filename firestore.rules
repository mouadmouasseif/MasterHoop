rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function activeAccount() { return signedIn() && request.auth.token.get('accountStatus', 'active') == 'active'; }
    function claimRole() { return request.auth.token.get('role', 'athlete'); }
    function claimClubId() { return request.auth.token.get('clubId', ''); }
    function isOwner(userId) { return activeAccount() && request.auth.uid == userId; }
    function isSuperAdmin() { return activeAccount() && claimRole() == 'super_admin'; }
    function isClubAdmin(clubId) { return activeAccount() && claimRole() == 'club_admin' && claimClubId() == clubId; }
    function coachLinkId(athleteId) { return request.auth.uid + '_' + athleteId; }
    function isAssignedCoach(athleteId) {
      return activeAccount()
        && claimRole() == 'coach'
        && exists(/databases/$(database)/documents/coachAthleteLinks/$(coachLinkId(athleteId)))
        && get(/databases/$(database)/documents/coachAthleteLinks/$(coachLinkId(athleteId))).data.status == 'active';
    }
    function ownerOf(data) { return data.get('ownerId', data.get('userId', '')); }
    function athleteOf(data) { return data.get('athleteId', ownerOf(data)); }
    function clubOf(data) { return data.get('clubId', ''); }
    function canReadAthleteData(data) {
      return isOwner(athleteOf(data)) || isAssignedCoach(athleteOf(data)) || isClubAdmin(clubOf(data)) || isSuperAdmin();
    }
    function immutableOwnership() {
      return ownerOf(request.resource.data) == ownerOf(resource.data)
        && athleteOf(request.resource.data) == athleteOf(resource.data)
        && clubOf(request.resource.data) == clubOf(resource.data);
    }
    function isParticipant(data) { return activeAccount() && request.auth.uid in data.get('participantUids', []); }
    function isTeamMember(teamId) {
      return activeAccount() && exists(/databases/$(database)/documents/teams/$(teamId))
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('memberUids', []);
    }
    function isTeamAdmin(teamId) {
      return activeAccount() && exists(/databases/$(database)/documents/teams/$(teamId)) && (
        get(/databases/$(database)/documents/teams/$(teamId)).data.captain == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('adminUids', [])
      );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin()
        || (claimRole() == 'coach' && isAssignedCoach(userId))
        || (claimRole() == 'club_admin' && isClubAdmin(resource.data.get('clubId', '')));
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('role', 'athlete') == 'athlete'
        && request.resource.data.get('accountStatus', 'active') == 'active';
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('role', 'athlete') == resource.data.get('role', 'athlete')
        && request.resource.data.get('clubId', '') == resource.data.get('clubId', '')
        && request.resource.data.get('coachId', '') == resource.data.get('coachId', '')
        && request.resource.data.get('accountStatus', 'active') == resource.data.get('accountStatus', 'active');
      allow create, update, delete: if isSuperAdmin();

      match /sessions/{sessionId} {
        allow read: if isOwner(userId) || isAssignedCoach(userId) || isSuperAdmin();
        allow create: if isOwner(userId) && request.resource.data.get('userId', userId) == userId;
        allow update: if isOwner(userId) && request.resource.data.get('userId', userId) == resource.data.get('userId', userId);
        allow delete: if isOwner(userId);
      }
    }

    match /coachAthleteLinks/{linkId} {
      allow read: if activeAccount() && (resource.data.coachId == request.auth.uid || resource.data.athleteId == request.auth.uid || isClubAdmin(resource.data.get('clubId', '')) || isSuperAdmin());
      allow create: if activeAccount() && request.resource.data.athleteId == request.auth.uid
        && request.resource.data.status == 'active'
        && linkId == request.resource.data.coachId + '_' + request.resource.data.athleteId;
      allow update: if activeAccount() && resource.data.athleteId == request.auth.uid
        && request.resource.data.coachId == resource.data.coachId
        && request.resource.data.athleteId == resource.data.athleteId
        && request.resource.data.get('clubId', '') == resource.data.get('clubId', '');
      allow delete: if activeAccount() && (resource.data.athleteId == request.auth.uid || isSuperAdmin());
    }

    match /invitations/{invitationId} {
      allow read: if activeAccount() && (resource.data.senderId == request.auth.uid || resource.data.get('recipientId', '') == request.auth.uid || isClubAdmin(resource.data.get('clubId', '')) || isSuperAdmin());
      allow create: if activeAccount() && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt > request.time
        && (claimRole() in ['super_admin', 'club_admin', 'coach']);
      allow update: if activeAccount() && resource.data.status == 'pending'
        && resource.data.expiresAt > request.time
        && resource.data.get('recipientId', '') == request.auth.uid
        && request.resource.data.get('recipientId', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if isSuperAdmin();
    }

    match /analyses/{analysisId} {
      allow read: if canReadAthleteData(resource.data);
      allow create: if isOwner(ownerOf(request.resource.data)) && athleteOf(request.resource.data) == request.auth.uid;
      allow update: if immutableOwnership() && (
        isOwner(ownerOf(resource.data))
        || (isAssignedCoach(athleteOf(resource.data)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachComment', 'coachValidation', 'updatedAt']))
      );
      allow delete: if isOwner(ownerOf(resource.data)) || isSuperAdmin();
    }

    match /trainingSessions/{id} { allow read: if canReadAthleteData(resource.data); allow create: if isOwner(ownerOf(request.resource.data)); allow update: if immutableOwnership() && isOwner(ownerOf(resource.data)); allow delete: if isOwner(ownerOf(resource.data)); }
    match /aiReports/{id} { allow read: if canReadAthleteData(resource.data); allow create: if isOwner(ownerOf(request.resource.data)); allow update: if immutableOwnership() && isOwner(ownerOf(resource.data)); allow delete: if isOwner(ownerOf(resource.data)); }
    match /videos/{id} { allow read: if canReadAthleteData(resource.data) || isParticipant(resource.data); allow create: if isOwner(ownerOf(request.resource.data)); allow update: if immutableOwnership() && isOwner(ownerOf(resource.data)); allow delete: if isOwner(ownerOf(resource.data)); }
    match /reports/{id} { allow read: if canReadAthleteData(resource.data); allow create: if isOwner(ownerOf(request.resource.data)); allow update: if immutableOwnership() && isOwner(ownerOf(resource.data)); allow delete: if isOwner(ownerOf(resource.data)); }
    match /trainings/{id} { allow read: if canReadAthleteData(resource.data); allow create: if isOwner(ownerOf(request.resource.data)); allow update: if immutableOwnership() && isOwner(ownerOf(resource.data)); allow delete: if isOwner(ownerOf(resource.data)); }
    match /userProfiles/{userId} { allow read, create, update, delete: if isOwner(userId); }

    match /clubs/{clubId} { allow read: if activeAccount() && (claimClubId() == clubId || isSuperAdmin()); allow write: if isSuperAdmin() || isClubAdmin(clubId); }
    match /modelRegistry/{id} { allow read: if activeAccount(); allow write: if isSuperAdmin(); }
    match /auditLogs/{id} { allow read: if isSuperAdmin(); allow write: if false; }
    match /consents/{id} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) && request.resource.data.get('userId', resource.data.userId) == resource.data.userId;
    }

    match /friend_requests/{id} { allow read: if activeAccount() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); allow create: if activeAccount() && request.resource.data.fromUid == request.auth.uid; allow update, delete: if activeAccount() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); }
    match /friendRequests/{id} { allow read: if activeAccount() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); allow create: if activeAccount() && request.resource.data.fromUid == request.auth.uid; allow update, delete: if activeAccount() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); }
    match /friends/{id} { allow read, update, delete: if isOwner(resource.data.userId) || isParticipant(resource.data); allow create: if isOwner(request.resource.data.userId) || isParticipant(request.resource.data); }
    match /teams/{teamId} { allow read: if isTeamMember(teamId) || isTeamAdmin(teamId); allow create: if activeAccount() && request.resource.data.captain == request.auth.uid; allow update, delete: if isTeamAdmin(teamId); }
    match /teamMembers/{id} { allow read: if isTeamMember(resource.data.teamId); allow create, update, delete: if isTeamAdmin(request.resource.data.teamId); }
    match /teamInvites/{id} { allow read: if activeAccount() && (resource.data.get('toUid', '') == request.auth.uid || isTeamAdmin(resource.data.teamId)); allow create: if isTeamAdmin(request.resource.data.teamId); allow update, delete: if activeAccount() && (resource.data.get('toUid', '') == request.auth.uid || isTeamAdmin(resource.data.teamId)); }
    match /matches/{id} { allow read: if isParticipant(resource.data) || isOwner(resource.data.userId); allow create: if isOwner(request.resource.data.userId) && isParticipant(request.resource.data); allow update: if isParticipant(resource.data) || isOwner(resource.data.userId); allow delete: if isOwner(resource.data.userId); }
    match /matchInvites/{id} { allow read: if activeAccount() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); allow create: if activeAccount() && request.resource.data.fromUid == request.auth.uid; allow update, delete: if activeAccount() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid); }
    match /notifications/{id} { allow read, update, delete: if isOwner(resource.data.userId); allow create: if activeAccount() && request.resource.data.userId == request.auth.uid; }
    match /highlights/{id} { allow read: if isOwner(resource.data.userId) || isParticipant(resource.data); allow create: if isOwner(request.resource.data.userId); allow update, delete: if isOwner(resource.data.userId); }
    match /leaderboards/{id} { allow read: if activeAccount(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
